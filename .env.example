# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Server Environment 
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
MODEL_URL=http://localhost:5000
PRE_PRODUCTION_URL=

# PostgreSQL
DATABASE_POSTGRES_URL_PRISMA="postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>"
DATABASE_POSTGRES_URL_DEV="postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>"
DATABASE_POSTGRES_URL_PROD="postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?sslmode=require"

# MongoDB
DATABASE_MONGO_URL_PRISMA="mongodb://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>"
DATABASE_MONGO_URL_DEV="mongodb://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>"
DATABASE_MONGO_URL_PROD="mongodb://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>"

# JWT Secrets
JWT_SECRET="your_super_secret_key"
REFRESH_SECRET="your_super_refresh_secret_key"

# Nodemailer
EMAIL_USER=<YOUR_EMAIL>
EMAIL_PASS=<YOUR_EMAIL_PASSWORD>

# Cors and Client URLs
CLIENT_URL=http://localhost:5173
PRODUCTION_URL=<PRODUCTION_URL>
FRONTEND_URL=<FRONTEND_URL>